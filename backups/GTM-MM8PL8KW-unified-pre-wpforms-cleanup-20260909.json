   "workspaceId": "18",
   "variableId": "26",
   "name": "Custom JavaScript - Form Email",
   "type": "jsm",
   "parameter": [
    {
     "type": "template",
     "key": "javascript",
     "value": "function() {\n  // Try to find the most recently used WPForms form\n  var forms = document.querySelectorAll('form.wpforms-form');\n  if (!forms || !forms.length) return;\n\n  // Work backwards (last form on page is often the main LP form)\n  for (var i = forms.length - 1; i >= 0; i--) {\n    var form = forms[i];\n    if (!form) continue;\n\n    var emailField = form.querySelector(\n      'input[type=\"email\"], input[name*=\"email\"], input[name*=\"Email\"]'\n    );\n    if (emailField && emailField.value) {\n      return emailField.value;\n    }\n  }\n\n  return;\n}"
    }
   ],
   "fingerprint": "1763789778588",
   "tagManagerUrl": "https://tagmanager.google.com/#/container/accounts/6300833419/containers/223334563/workspaces/18/variables/26?apiLink=variable",
