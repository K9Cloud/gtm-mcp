     "value": "function() {\n  var forms = document.querySelectorAll('form.wpforms-form');\n  if (!forms || !forms.length) return;\n\n  for (var i = forms.length - 1; i >= 0; i--) {\n    var form = forms[i];\n    if (!form) continue;\n\n    var phoneField = form.querySelector(\n      'input[type=\"tel\"], input[name*=\"phone\"], input[name*=\"Phone\"], input[name*=\"tel\"], input[name*=\"Tel\"]'\n    );\n    if (phoneField && phoneField.value) {\n      return phoneField.value;\n    }\n  }\n\n  return;\n}"
